# ---- required --------------------------------------------------------------
# The single password you type to sign in.
APP_PASSWORD=change-me
# Random string (>=16 chars) used to sign login tokens. Generate: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string

# ---- database ---------------------------------------------------------------
# Local dev: leave empty -> uses ./data/local.db (SQLite file).
# Vercel: REQUIRED. Create a free DB at https://turso.tech  (turso db create / turso db tokens create)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ---- AI (photo analysis, text parsing, chat) --------------------------------
# The app tries each provider/model below in order until one answers, so a single
# overloaded service never blocks you. Providers without a key are skipped.
# You need at least ONE key; more keys = more resilience (all have free tiers).

# 1) Google Gemini — free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional overrides (comma-separated). Defaults:
#   GEMINI_MODEL=gemini-flash-latest
#   GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-2.5-flash,gemini-2.5-flash-lite
GEMINI_MODEL=
GEMINI_FALLBACK_MODELS=

# 2) Groq (very fast, free tier) — https://console.groq.com/keys
GROQ_API_KEY=
# default: meta-llama/llama-4-scout-17b-16e-instruct
GROQ_MODEL=

# 3) OpenRouter (free models tagged ":free") — https://openrouter.ai/keys
OPENROUTER_API_KEY=
# default: google/gemma-3-27b-it:free   (must be a vision-capable model for photos)
OPENROUTER_MODEL=

# 4) Mistral (free "Experiment" plan) — https://console.mistral.ai
MISTRAL_API_KEY=
# default: mistral-small-latest
MISTRAL_MODEL=

# Optional: change the order providers are tried in (default: gemini,groq,openrouter,mistral)
AI_PROVIDER_ORDER=

# ---- optional ---------------------------------------------------------------
# Free key from https://fdc.nal.usda.gov/api-key-signup — if set, AI-estimated foods are
# cross-checked against USDA nutrient data (only used when it agrees with the AI within 30%).
USDA_API_KEY=
